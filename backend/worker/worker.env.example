# Copy to worker.env on the GPU machine.
API_URL=https://api.yoursite.com
WORKER_TOKEN=same-value-as-the-api
# The API's box PUBLIC key (from `npm run gen-keys` in api/). Ground secrets are sealed to it.
BOX_PUBLIC_KEY=
# vanity (GPU) or solana-keygen (CPU, for testing without a GPU)
GRINDER=vanity
VANITY_BIN=vanity
# Stylized matching: fiRE... counts as fire. true (default) is much faster. false = exact case.
CASE_INSENSITIVE=true

# Which queue this box serves: any (default), coin, or wallet.
# On a multi-GPU box you can run two groups — e.g. LANE=coin on one, LANE=wallet
# on the other — so a long coin grind never starves vanity wallet requests.
LANE=any
# Longest prefix this worker will accept (1-12).
MAX_LEN=8
